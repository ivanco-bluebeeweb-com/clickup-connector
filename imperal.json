      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "Friendly connection label, e.g. Engineering ClickUp.",
            "title": "Label",
            "type": "string"
          },
          "api_token": {
            "description": "ClickUp Personal API token (pk_...) or OAuth Bearer token.",
            "title": "Api Token",
            "type": "string"
          }
        },
        "required": [
          "api_token"
        ],
        "title": "ConnectClickUpParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {
            "description": "Connection ID",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "description": "Connection label",
            "title": "Label",
            "type": "string"
          },
          "status": {
            "default": "connected",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "ConnectResult",
        "type": "object"
      },
      "event": "clickup-connector.connect_clickup",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_clickup-connector_chat"
